<div>
    <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => ViewModel.CreateGoalCommand.ExecuteAsync(null)">Add goal</MudButton>
</div>

@if (!ViewModel.IsLoaded)
{
    <MudProgressCircular Indeterminate />
}
else if (ViewModel.Goals.Count > 0)
{
    <MudGrid>
        @foreach (var goal in ViewModel.Goals)
        {
            <GoalCard ViewModel="goal" />
        }
    </MudGrid>
}