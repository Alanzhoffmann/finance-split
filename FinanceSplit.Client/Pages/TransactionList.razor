@page "/transactions"

<PageTitle>Transactions</PageTitle>

<MudContainer>
    <MudStack>
        <MudText Typo="Typo.h3" GutterBottom="true">Transactions</MudText>
        <MudDatePicker Label="Month"
                       OpenTo="OpenTo.Month"
                       FixDay="1"
                       DateFormat="MMM/yyyy"
                       TitleDateFormat="MMM/yyyy"
                       Date="@(ViewModel.CurrentMonth.ToDateTime(TimeOnly.MinValue))"
                       DateChanged="OnMonthSelected" />
        <div>
            <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => ViewModel.CreateTransactionCommand.ExecuteAsync(null)">Add transaction</MudButton>
        </div>

        @if (ViewModel.Transactions == null)
        {
            <MudProgressCircular Color="Color.Default" Indeterminate="true" />
        }
        else
        {
            <MudTable Items="ViewModel.Transactions" Dense Hover="true" SortLabel="Sort By">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Value</MudTh>
                    <MudTh>Split</MudTh>
                    <MudTh>Paid by</MudTh>
                    <MudTh>Shared with</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name"><strong>@context.Name</strong></MudTd>
                    <MudTd DataLabel="Value">@context.Value.ToString("C", _enGb)</MudTd>
                    <MudTd DataLabel="Split">@context.SplitType</MudTd>
                    <MudTd DataLabel="Paid by">@context.PaidBy.Name</MudTd>
                    <MudTd DataLabel="Shared with">@string.Join(", ", context.SharedWith.Select(r => r.Name))</MudTd>
                    <MudTd>
                        <div class="d-inline-flex justify-end align-center flex-grow-1 gap-4">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Edit" aria-label="edit" OnClick="@(() => ViewModel.EditTransactionCommand.ExecuteAsync(context))" />
                            <MudIconButton Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Outlined.Delete" aria-label="delete" OnClick="@(() => ViewModel.DeleteTransactionCommand.ExecuteAsync(context))" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
</MudContainer>