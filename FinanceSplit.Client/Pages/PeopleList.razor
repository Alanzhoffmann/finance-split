@page "/people"

<PageTitle>People</PageTitle>

<MudContainer>
    <MudStack>
        <MudText Typo="Typo.h3" GutterBottom="true">People</MudText>
        <div>
            <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => ViewModel.CreatePersonCommand.ExecuteAsync(null)">Add person</MudButton>
        </div>
        @if (!ViewModel.IsLoaded)
        {
            <MudProgressCircular Color="Color.Default" Indeterminate="true" />
        }
        else if (ViewModel.People.Count == 0)
        {
            <MudText>No one is in</MudText>
        }
        else
        {
            <MudGrid>
                @foreach (var person in ViewModel.People)
                {
                    var count = ViewModel.People.Count;

                    <MudItem md="count == 1 ? 12 : count % 3 == 0 && count % 2 == 1 ? 4 : 6" xs="12">
                        <PersonCard Person="person" />
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStack>
</MudContainer>