@page "/"

<PageTitle>Dashboard</PageTitle>

<MudContainer>
    <MudDatePicker Label="Month" @bind-Date="@Month" OpenTo="OpenTo.Month" FixDay="1" DateFormat="MMM/yyyy" For="@(() => Month)" />

    @if (Data is not null)
    {
        <MudGrid>
            @foreach (var person in Data.People)
            {
                <MudItem md="4" sm="6" xs="12">
                    <MudCard>
                        <MudCardHeader><MudText Typo="Typo.h4">@person.Name</MudText></MudCardHeader>
                        <MudCardContent>
                            <MudText>Income: @person.Income.ToString("C", _enGb)</MudText>
                            <MudText>Total expenses: @person.TotalExpenses.ToString("C", _enGb)</MudText>
                            <MudText>Total paid: @person.TotalPaid.ToString("C", _enGb)</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudAlert Severity="Severity.Warning">No people set up</MudAlert>
    }
</MudContainer>