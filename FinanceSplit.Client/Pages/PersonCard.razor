<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h4">@ViewModel.Name</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Outlined.Edit" aria-label="edit" OnClick="@(() => ViewModel.EditPersonCommand.ExecuteAsync(null))" />
            <MudIconButton Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" aria-label="delete" OnClick="@(() => ViewModel.DeletePersonCommand.ExecuteAsync(null))" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudTable Items="ViewModel.Incomes" Dense GroupBy="_groupDefinition" Elevation="0">
            <HeaderContent>
                <MudTh>Month</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>Type</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd DataLabel="Month">@context.Month.ToString("MMM/yyyy")</MudTd>
                <MudTd DataLabel="Amount">@context.Amount.ToString("C", _enGb)</MudTd>
                <MudTd DataLabel="Type">@context.Type</MudTd>
                <MudTd>
                    <div class="d-inline-flex justify-end align-center flex-grow-1 gap-4">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Edit" aria-label="edit" OnClick="@(() => ViewModel.EditIncomeRecordCommand.ExecuteAsync(context))" />
                        <MudIconButton Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Outlined.Delete" aria-label="delete" OnClick="@(() => ViewModel.DeleteIncomeRecordCommand.ExecuteAsync(context))" />
                    </div>
                </MudTd>
            </RowTemplate>
            <GroupFooterTemplate>
                <MudTh Style="text-align: right;" colspan="4"><MudText Typo="Typo.subtitle1">Total @context.Key: @context.Items.Sum((e) => e.Amount).ToString("C", _enGb)</MudText></MudTh>
            </GroupFooterTemplate>
        </MudTable>
    </MudCardContent>
    <MudCardActions>
        <MudSpacer /><MudFab Variant="Variant.Filled" Size="Size.Small" EndIcon="@Icons.Material.Outlined.Add" Label="Add income" Color="Color.Primary" OnClick="@(() => ViewModel.CreateIncomeRecordCommand.ExecuteAsync(null))" />
    </MudCardActions>
</MudCard>

                